---
import Base from '../layouts/Base.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import { CHROME_STORE_URL, GITHUB_URL } from '../lib/links';

export const prerender = true;

const agents = [
  ['claude', 'Claude Code'],
  ['openai', 'Codex'],
  ['cursor', 'Cursor'],
  ['githubcopilot', 'Copilot'],
  ['windsurf', 'Windsurf'],
  ['googlegemini', 'Gemini CLI'],
];

const steps = [
  { n: '01', label: 'Open a docs page' },
  { n: '02', label: 'Click scoop.md' },
  { n: '03', label: 'Paste into your agent' },
];
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">Scoop <span class="mark">any</span> doc.</h1>
    <p class="lede">One click on any docs page copies agent-ready Markdown.</p>

    <div class="cta">
      <a class="btn" href={CHROME_STORE_URL ?? GITHUB_URL} data-cta={CHROME_STORE_URL ? 'chrome_store' : 'github_coming_soon'}>
        {CHROME_STORE_URL ? 'Add to Chrome' : 'Coming soon to Chrome'} <span aria-hidden="true">→</span>
      </a>
      <div class="quiet-links">
        <a class="quiet" href="/library" data-cta="library">Browse library</a>
        <span class="quiet-sep" aria-hidden="true">·</span>
        <a class="quiet" href={GITHUB_URL} data-cta="github">GitHub</a>
      </div>
    </div>

    <HeroAnimation />
  </section>

  <!-- How it works: three-step strip -->
  <section class="steps-section wrap reveal-section" aria-labelledby="steps-title">
    <p class="eyebrow" id="steps-title">## how it works</p>
    <ol class="steps">
      {steps.map(({ n, label }) => (
        <li class="step">
          <span class="step-n" aria-hidden="true">{n}</span>
          <span class="step-label">{label}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- Paste into -->
  <section class="agents-section wrap reveal-section" aria-labelledby="agents-title">
    <p class="eyebrow" id="agents-title">## paste into</p>
    <ul class="agents">
      {
        agents.map(([logo, name]) => (
          <li>
            <span class="logo" style={`--logo:url(/agents/${logo}.svg)`} aria-hidden="true" />
            {name}
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  // Scroll-reveal: sections below-the-fold enter with a subtle slide-up.
  // Sections already in-viewport on first paint are made visible immediately.
  const els = document.querySelectorAll<HTMLElement>('.reveal-section');
  if (els.length) {
    const vh = window.innerHeight;

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('visible');
          io.unobserve(e.target);
        }
      }),
      { threshold: 0.08 }
    );

    els.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < vh) {
        // Already in viewport on load: show immediately, no transition
        el.classList.add('visible');
      } else {
        // Below fold: enable hidden state + observe
        el.setAttribute('data-reveal', 'true');
        io.observe(el);
      }
    });
  }
</script>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: clamp(4rem, 14vh, 9rem);
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }

  h1 {
    font-size: clamp(3rem, 1.5rem + 8vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 0 0 1.25rem;
  }

  .lede {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--ink-2);
    max-width: 34ch;
    margin: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 2.25rem 0 2.5rem;
  }

  .quiet-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .quiet {
    color: var(--ink-2);
    font-weight: 500;
  }

  .quiet-sep {
    color: var(--muted);
    font-size: 0.75rem;
  }

  /* ── Steps section ── */
  .steps-section {
    padding-top: clamp(2rem, 5vh, 4rem);
    padding-bottom: clamp(2rem, 5vh, 4rem);
    border-top: 1px solid var(--rule);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .step {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex: 1;
    min-width: 160px;
  }

  .step-n {
    font: 600 0.78rem/1 var(--font-mono);
    color: var(--accent);
    flex-shrink: 0;
  }

  .step-label {
    font: 500 1rem/1.3 var(--font-body);
    color: var(--ink);
  }

  /* ── Agents section ── */
  .agents-section {
    padding-top: clamp(2rem, 5vh, 4rem);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    border-top: 1px solid var(--rule);
  }

  .agents {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agents li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .logo {
    width: 15px;
    height: 15px;
    flex: none;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  /* ── Scroll-reveal entrance ── */
  /* Only applies once JS marks the section with data-reveal */
  .reveal-section[data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .6s cubic-bezier(.2,.8,.2,1), transform .6s cubic-bezier(.2,.8,.2,1);
  }

  .reveal-section[data-reveal].visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-section[data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
