---
// Pure CSS / vanilla-JS looping demo of the copy flow: the site\u2019s llms.txt and its instructions for agents.
// No Lottie dependency. Honors prefers-reduced-motion.
---

<div
  class="hero-stage"
  role="img"
  aria-label="A browser frame on a docs page, the scoop.md toolbar icon lights up, the popup opens showing the site\u2019s llms.txt link and its instructions for agents, the cursor clicks Copy llms.txt + instructions, and the prompt lands in a terminal."
>
  <!-- Browser chrome -->
  <div class="browser">
    <div class="browser-bar">
      <div class="browser-dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="browser-url" aria-hidden="true">
        <span class="url-lock">&#128274;</span>
        docs.stripe.com
      </div>
      <div class="toolbar" aria-hidden="true">
        <div class="ext-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>
        <div class="scoop-icon">
          <img src="/favicon.png" width="16" height="16" alt="" />
          <span class="badge">✓</span>
        </div>
      </div>
    </div>

    <!-- Browser content area -->
    <div class="browser-content">
      <!-- Page skeleton -->
      <div class="page-skeleton" aria-hidden="true">
        <div class="page-sidebar">
          <div class="sk sk-1"></div>
          <div class="sk sk-2"></div>
          <div class="sk sk-3"></div>
          <div class="sk sk-4"></div>
          <div class="sk sk-5"></div>
          <div class="sk sk-6"></div>
          <div class="sk sk-7"></div>
        </div>
        <div class="page-body">
          <div class="sk sk-h1"></div>
          <div class="sk sk-p1"></div>
          <div class="sk sk-p2"></div>
          <div class="sk sk-p3"></div>
          <div class="sk sk-code"></div>
          <div class="sk sk-p4"></div>
          <div class="sk sk-p5"></div>
          <div class="sk sk-p6"></div>
        </div>
      </div>

      <!-- Popup anchored inside browser-content, top-right -->
      <div class="popup" aria-hidden="true">
        <div class="popup-bar">
          <div class="popup-brand">
            <img src="/favicon.png" width="18" height="18" alt="" />
            <span>scoop.md</span>
          </div>
        </div>
        <div class="popup-body">
          <!-- Line 1: the llms.txt chip and its link -->
          <div class="qline qline-1">
            <span class="label-chip">llms.txt</span>
            <div class="field"><span class="field-url">docs.stripe.com/llms.txt</span></div>
          </div>
          <!-- Line 2: what it holds -->
          <div class="qline qline-2">
            <span class="qmeta">527 pages · checked today</span>
          </div>
          <!-- Line 3: instructions for agents -->
          <div class="qline qline-3">
            <span class="label-chip">Instructions for agents</span>
          </div>
          <!-- Line 4: the instructions, quoted from the llms.txt -->
          <div class="qline qline-4">
            <div class="preview-box" aria-hidden="true">
              <div class="pv-line pv-1">## Best practices for integrating Stripe</div>
              <div class="pv-line pv-2">- Use the Checkout Sessions API</div>
              <div class="pv-line pv-3">- Prefer Stripe-hosted payment pages</div>
              <div class="preview-fade"></div>
            </div>
          </div>
          <!-- Copy button: two labels cross-fade -->
          <div class="qline qline-6">
            <button class="copy-btn" tabindex="-1">
              <span class="lbl lbl-copy">Copy llms.txt + instructions</span>
              <span class="lbl lbl-copied">Copied ✓</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stage footer: terminal card in normal flow -->
  <div class="stage-footer" aria-hidden="true">
    <div class="terminal-card">
      <span class="term-prompt">claude ›</span>
      <span class="term-idle"><span class="term-caret"></span></span>
      <span class="term-pasted">pasted the llms.txt link + instructions <span class="term-ok">✓</span></span>
    </div>
  </div>

  <!-- Markdown sheet flyout (absolute in hero-stage) -->
  <div class="md-sheet" aria-hidden="true">
    <div class="md-line md-h"></div>
    <div class="md-line md-p"></div>
    <div class="md-line md-p md-short"></div>
    <div class="md-line md-code"></div>
  </div>

  <!-- Cursor -->
  <div class="cursor" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
      <path d="M4 2L16 10L10 11L7 18L4 2Z" fill="var(--ink)" stroke="var(--paper)" stroke-width="1.5"/>
    </svg>
  </div>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  if (!stage) throw new Error('hero-stage missing');

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (still) {
    // End-state: everything revealed, Copied ✓
    ['state-badge','state-popup-open',
     'state-line1','state-line2','state-line3','state-line4','state-line5',
     'state-copied','state-pasted'].forEach(c => stage.classList.add(c));
  } else {
    // Timeline (ms from loop start)
    const LOOP_MS = 11000; // 1.5 s hold on final state before reset

    const frames: [number, string][] = [
      [ 350, 'state-badge'],
      [ 850, 'state-popup-open'],
      [1150, 'state-line1'],
      [1450, 'state-line2'],
      [1750, 'state-line3'],
      [2050, 'state-line4'],
      [2400, 'state-line5'],
      [3100, 'state-cursor-copy'],
      [3500, 'state-copied'],
      [4200, 'state-flyout'],
      [5000, 'state-pasted'],
      // Hold until LOOP_MS - 800 = 10200 ms
    ];

    const allClasses = frames.map(([, c]) => c).concat('state-reset');
    let timers: ReturnType<typeof setTimeout>[] = [];
    let running = false;

    const clearAll = () => {
      timers.forEach(clearTimeout);
      timers = [];
      allClasses.forEach(c => stage.classList.remove(c));
    };

    const runLoop = () => {
      clearAll();
      for (const [delay, cls] of frames) {
        timers.push(setTimeout(() => stage.classList.add(cls), delay));
      }
      // Fade out, then restart
      timers.push(setTimeout(() => {
        stage.classList.add('state-reset');
        timers.push(setTimeout(runLoop, 750));
      }, LOOP_MS - 750));
    };

    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !running) { running = true; runLoop(); }
      else if (!e.isIntersecting && running) { running = false; clearAll(); }
    });
    io.observe(stage);
  }
</script>

<style>
  /* ── Outer container ── */
  .hero-stage {
    position: relative;
    width: 100%;
    max-width: 860px;
    margin: 2.5rem auto 0;
    user-select: none;
  }

  /* ── Browser shell ── */
  .browser {
    position: relative;
    width: 100%;
    border: 1.5px solid var(--rule);
    border-radius: 10px;
    overflow: hidden; /* popup is inside browser-content now */
    background: var(--sheet);
    box-shadow: 0 4px 24px rgba(0,0,0,.08), 0 1px 4px rgba(0,0,0,.06);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    height: 38px;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    flex-shrink: 0;
  }

  .browser-dots { display: flex; gap: 5px; flex-shrink: 0; }
  .browser-dots span { width: 9px; height: 9px; border-radius: 50%; }
  .browser-dots span:nth-child(1) { background: #ff5f57; }
  .browser-dots span:nth-child(2) { background: #febc2e; }
  .browser-dots span:nth-child(3) { background: #28c840; }

  .browser-url {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    font: 500 11px/1 var(--font-mono);
    color: var(--muted);
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 3px 8px;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .url-lock { font-size: 9px; }

  .toolbar { display: flex; align-items: center; gap: 5px; flex-shrink: 0; }
  .ext-icon {
    width: 22px; height: 22px;
    display: grid; place-items: center;
    border-radius: 4px;
    color: var(--muted);
    opacity: .5;
  }
  .scoop-icon {
    position: relative;
    width: 22px; height: 22px;
    display: grid; place-items: center;
    border-radius: 4px;
    background: var(--sheet);
    border: 1px solid var(--rule);
  }

  /* Green badge on toolbar icon */
  .badge {
    position: absolute;
    bottom: -3px; right: -4px;
    font-size: 7px; line-height: 1;
    background: #2e7d32;
    color: #fff;
    border-radius: 99px;
    padding: 1px 3px;
    opacity: 0;
    transform: scale(0.5);
    transition: opacity .3s cubic-bezier(.2,.8,.2,1), transform .3s cubic-bezier(.2,.8,.2,1);
  }
  .hero-stage.state-badge .badge { opacity: 1; transform: scale(1); }

  /* ── Browser content: skeleton + popup side by side ── */
  .browser-content {
    display: flex;
    min-height: 360px;
  }

  /* Page skeleton */
  .page-skeleton {
    flex: 1;
    display: flex;
    min-height: 0;
    overflow: hidden;
  }

  .page-sidebar {
    width: 160px;
    flex-shrink: 0;
    padding: 14px 12px;
    border-right: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .page-body {
    flex: 1;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  .sk { border-radius: 3px; background: var(--rule); height: 9px; }
  .page-sidebar .sk { height: 8px; }
  .sk-1 { width: 72%; }
  .sk-2 { width: 55%; }
  .sk-3 { width: 80%; }
  .sk-4 { width: 48%; }
  .sk-5 { width: 66%; }
  .sk-6 { width: 38%; }
  .sk-7 { width: 58%; }
  .sk-h1 { height: 17px; width: 50%; margin-bottom: 4px; }
  .sk-p1 { width: 88%; }
  .sk-p2 { width: 76%; }
  .sk-p3 { width: 58%; }
  .sk-code { height: 44px; background: color-mix(in srgb, var(--rule) 80%, var(--paper)); border-radius: 4px; width: 72%; margin: 4px 0; }
  .sk-p4 { width: 84%; }
  .sk-p5 { width: 66%; }
  .sk-p6 { width: 44%; }

  /* ── Popup ── */
  /* Anchored to browser-content top-right; fully inside browser */
  .popup {
    width: 272px;
    flex-shrink: 0;
    border-left: 1px solid #f3dccb;
    background: #ffeee0;
    font-family: ui-rounded, -apple-system, system-ui, sans-serif;
    transform-origin: top right;
    transform: scale(0.88) translateX(6px);
    opacity: 0;
    transition: transform .38s cubic-bezier(.2,.8,.2,1), opacity .3s cubic-bezier(.2,.8,.2,1);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .popup {
      background: #1f1510;
      border-color: #3d3631;
    }
    :root:not([data-theme="light"]) .popup-bar { background: #2b2623 !important; border-color: #3d3631 !important; }
    :root:not([data-theme="light"]) .label-chip { background: #3a2a20 !important; }
    :root:not([data-theme="light"]) .field { background: #231f1c !important; border-color: #3d3631 !important; }
    :root:not([data-theme="light"]) .field-url { color: #f5ece6 !important; }
    :root:not([data-theme="light"]) .copy-btn { background: #c2410c !important; }
    :root:not([data-theme="light"]) .preview-box { background: #231f1c !important; border-color: #3d3631 !important; }
    :root:not([data-theme="light"]) .pv-line { color: #f5ece6 !important; }
    :root:not([data-theme="light"]) .qmeta { color: #b5a397 !important; }
    :root:not([data-theme="light"]) .popup-brand span { color: #ff9a5c !important; }
  }

  .hero-stage.state-popup-open .popup {
    transform: scale(1) translateX(0);
    opacity: 1;
  }

  .popup-bar {
    padding: 10px 12px 8px;
    background: #ffeee0;
    border-bottom: 1px solid #f3dccb;
  }
  .popup-brand {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: #c2410c;
    letter-spacing: -0.02em;
  }
  .popup-brand img { border-radius: 4px; }

.label-chip {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: #fff4ec;
    color: #c2410c;
    font-size: 10.5px;
    font-weight: 700;
  }
  .field {
    margin-top: 5px;
    padding: 6px 8px;
    background: #fff8f3;
    border: 1px solid #f3dccb;
    border-radius: 7px;
  }
  .field-url {
    display: block;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    color: #2b1b10;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .popup-body {
    display: flex;
    flex-direction: column;
    padding: 8px 10px 10px;
    background: #fff;
    border-top: 1px solid #f3dccb;
  }

  /* The popup's lines */
  .qline {
    padding: 4px 0;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity .28s cubic-bezier(.2,.8,.2,1), transform .28s cubic-bezier(.2,.8,.2,1);
    font-size: 11.5px;
    line-height: 1.4;
  }

  .hero-stage.state-line1 .qline-1 { opacity: 1; transform: translateY(0); }
  .hero-stage.state-line2 .qline-2 { opacity: 1; transform: translateY(0); }
  .hero-stage.state-line3 .qline-3 { opacity: 1; transform: translateY(0); }
  .hero-stage.state-line4 .qline-4 { opacity: 1; transform: translateY(0); }
  .hero-stage.state-line5 .qline-5 { opacity: 1; transform: translateY(0); }
  /* Show Copy button once all content is visible */
  .hero-stage.state-line5 .qline-6 { opacity: 1; transform: translateY(0); }

  .qmeta { font-size: 11px; color: #7a5a44; font-weight: 500; }
  /* Preview box: 3 monospace lines with a bottom fade */
  .preview-box {
    position: relative;
    width: 100%;
    background: #fff8f3;
    border: 1px solid #f3dccb;
    border-radius: 7px;
    padding: 6px 8px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 9.5px;
    line-height: 1.5;
    overflow: hidden;
    height: 56px;
  }

  .pv-line {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
    color: #2b1b10;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity .25s ease, transform .25s ease;
  }

  /* Stagger pv-line reveals when qline-5 becomes visible */
  .hero-stage.state-line4 .pv-line { opacity: 1; transform: translateY(0); }
  .hero-stage.state-line4 .pv-2 { transition-delay: .12s; }
  .hero-stage.state-line4 .pv-3 { transition-delay: .24s; }

  /* Fade the bottom of the preview box */
  .preview-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 18px;
    background: linear-gradient(transparent, #fff8f3);
    pointer-events: none;
  }

  /* Copy button: two labels cross-fading */
  .copy-btn {
    position: relative;
    width: 100%;
    padding: 0;
    min-height: 36px;
    border: none;
    border-radius: 9px;
    background: #c2410c;
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
    overflow: hidden;
    transition: background .25s ease;
  }

  .hero-stage.state-copied .copy-btn { background: #2e7d32; }

  .lbl {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity .2s ease, transform .2s ease;
  }

  /* "Copy" label: visible by default, hides when copied */
  .lbl-copy { opacity: 1; transform: translateY(0); }
  .hero-stage.state-copied .lbl-copy { opacity: 0; transform: translateY(-6px); }

  /* "Copied ✓" label: hidden by default, shows when copied */
  .lbl-copied { opacity: 0; transform: translateY(6px); }
  .hero-stage.state-copied .lbl-copied { opacity: 1; transform: translateY(0); }

  /* ── Stage footer: terminal card ── */
  .stage-footer {
    display: flex;
    justify-content: flex-end;
    padding: 10px 0 0;
  }

  .terminal-card {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: color-mix(in srgb, var(--ink) 92%, transparent);
    border-radius: 8px;
    font: 500 11.5px/1 var(--font-mono);
    color: #e8e0d8;
    box-shadow: 0 2px 10px rgba(0,0,0,.15);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .terminal-card {
      background: #0a0705;
      color: #e8e0d8;
    }
  }

  .term-prompt { color: var(--accent); opacity: .8; flex-shrink: 0; }

  .term-idle { display: flex; align-items: center; }
  .term-caret {
    display: inline-block;
    width: 6px; height: 13px;
    background: #e8e0d8;
    border-radius: 1px;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* Terminal idle → pasted transition */
  .term-idle {
    opacity: 1;
    transition: opacity .2s ease;
  }
  .hero-stage.state-pasted .term-idle { opacity: 0; width: 0; overflow: hidden; }

  .term-pasted {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity .3s ease .05s, transform .3s cubic-bezier(.2,.8,.2,1) .05s;
    white-space: nowrap;
  }
  .hero-stage.state-pasted .term-pasted { opacity: 1; transform: translateX(0); }

  .term-ok { color: #8fd694; font-weight: 700; }

  .hero-stage.state-pasted .terminal-card { box-shadow: 0 0 0 1.5px #2e7d32, 0 2px 10px rgba(0,0,0,.15); }

  /* ── Cursor ── */
  .cursor {
    position: absolute;
    top: 180px;
    right: 290px;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
    transition: top .55s cubic-bezier(.4,0,.2,1), right .55s cubic-bezier(.4,0,.2,1),
                opacity .3s ease;
  }
  .hero-stage.state-popup-open .cursor { opacity: 1; }
  .hero-stage.state-cursor-copy .cursor { top: 275px; right: 23px; }
  .hero-stage.state-copied .cursor {
    top: 275px; right: 23px;
    transform: scale(.85);
    transition: transform .1s ease, top .55s cubic-bezier(.4,0,.2,1), right .55s cubic-bezier(.4,0,.2,1);
  }

  /* ── Markdown sheet flyout ── */
  .md-sheet {
    position: absolute;
    /* Start near the copy button: bottom of popup area */
    bottom: 76px;
    right: 14px;
    width: 130px;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 7px;
    padding: 9px 11px;
    box-shadow: 0 4px 16px rgba(0,0,0,.1);
    opacity: 0;
    transform: scale(.72) translateY(6px);
    pointer-events: none;
    z-index: 15;
    transition: opacity .25s ease, transform .3s cubic-bezier(.2,.8,.2,1);
  }

  .hero-stage.state-flyout .md-sheet {
    animation: sheetFly 1s cubic-bezier(.4,0,.2,1) forwards;
  }

  @keyframes sheetFly {
    0%   { opacity: 1; transform: scale(1) translate(0, 0); }
    15%  { opacity: 1; }
    80%  { opacity: .6; }
    100% { opacity: 0; transform: scale(.72) translate(30px, 130px); }
  }

  .md-line { border-radius: 3px; background: var(--rule); margin-bottom: 5px; height: 7px; }
  .md-h { background: var(--ink); width: 65%; height: 8px; }
  .md-p { width: 100%; }
  .md-short { width: 55%; }
  .md-code { width: 78%; background: color-mix(in srgb, var(--rule) 70%, var(--paper)); height: 14px; border-radius: 3px; margin-bottom: 0; }

  /* ── Reset fade-out ── */
  .hero-stage.state-reset .browser { opacity: 0; transition: opacity .55s ease; }
  .hero-stage.state-reset .stage-footer { opacity: 0; transition: opacity .45s ease; }
  .hero-stage:not(.state-reset) .browser { opacity: 1; transition: opacity .3s ease; }
  .hero-stage:not(.state-reset) .stage-footer { opacity: 1; transition: opacity .3s ease; }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .page-sidebar { display: none; }

    /* Stack popup on top of skeleton instead of beside it */
    .browser-content {
      display: block;
      position: relative;
      min-height: 260px;
    }
    .page-skeleton {
      display: flex;
      width: 100%;
    }
    .popup {
      position: absolute;
      top: 0; right: 0;
      width: 230px;
      border-left: none;
      border: 1px solid #f3dccb;
      border-radius: 10px;
      box-shadow: 0 6px 24px rgba(122,60,20,.2);
      /* Subtle background so skeleton shows through edges */
    }

    .cursor { display: none; }
    .md-sheet { display: none; }
    .terminal-card { font-size: 10.5px; padding: 7px 10px; }
    .stage-footer { padding-top: 8px; }
  }

  /* ── Reduced motion: show Copied end-state statically ── */
  @media (prefers-reduced-motion: reduce) {
    .hero-stage * { transition: none !important; animation: none !important; }
    .badge { opacity: 1 !important; transform: scale(1) !important; }
    .popup { transform: scale(1) translateX(0) !important; opacity: 1 !important; }
    .qline { opacity: 1 !important; transform: none !important; }
    .pv-line { opacity: 1 !important; transform: none !important; }
    .copy-btn { background: #2e7d32 !important; }
    .lbl-copy { opacity: 0 !important; }
    .lbl-copied { opacity: 1 !important; transform: none !important; }
    .term-caret { animation: none !important; }
    .term-idle { opacity: 0 !important; }
    .term-pasted { opacity: 1 !important; transform: none !important; }
    .terminal-card { box-shadow: 0 0 0 1.5px #2e7d32, 0 2px 10px rgba(0,0,0,.15) !important; }
    .md-sheet { display: none !important; }
    .cursor { display: none !important; }
  }
</style>
