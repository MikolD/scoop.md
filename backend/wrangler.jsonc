// api.scoop.md Worker. The top level is the local-dev config (`wrangler dev`);
// deploy only with `--env staging` or `--env production`.
// Bindings and vars are non-inheritable, so each environment repeats them.
// IDs marked REPLACE_ME are placeholders: see README.md, "Before the first deploy".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scoop-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    // Invocation logs record the URL and request headers (install ID, client IP,
    // the admin Authorization header), so only our own one-line logs are kept.
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },

  "vars": {
    "ENVIRONMENT": "dev",
    "EXTENSION_IDS": "",
    "CRAWL_BUCKET_NAME": "scoop-crawl-dev",
    "E2B_TEMPLATE_ID": "qj0i8b1c3ndy70ksd7ze",
    "INDEX_DAILY_CAP_USD": "2",
    "INDEX_DAILY_TOTAL_CAP_USD": "10"
    // ALLOW_LOCALHOST, ALLOW_ANY_EXTENSION, ADMIN_TOKEN and RATE_KEY come from .dev.vars locally.
    // ALLOW_LOCALHOST is ignored unless ENVIRONMENT is "dev".
    // OPENROUTER_API_KEY (indexing) also comes from .dev.vars locally.
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "scoop-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "SKILLS", "bucket_name": "scoop-skills-dev" },
    { "binding": "CRAWL", "bucket_name": "scoop-crawl-dev" }
  ],
  "workflows": [
    { "name": "crawl-site-dev", "binding": "CRAWL_SITE", "class_name": "CrawlSite" }
  ],
  "ratelimits": [
    // Reads: 600 per minute per IP (docs/BACKEND.md §8). Hourly write limits live in D1.
    { "name": "READ_LIMITER", "namespace_id": "4100", "simple": { "limit": 600, "period": 60 } },
    // Search: 60 per minute per IP; each query costs a Workers AI embedding unless cached.
    { "name": "SEARCH_LIMITER", "namespace_id": "4110", "simple": { "limit": 60, "period": 60 } }
  ],
  // Workers AI and Vectorize have no local simulation, so `wrangler dev` uses the
  // real `scoop-chunks-dev` index (needs `wrangler login`). `wrangler dev --local`
  // (CI) turns remote bindings off: search then falls back to full-text only.
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [
    { "binding": "VECTORS", "index_name": "scoop-chunks-dev", "remote": true }
  ],
  // The crawler sends one message per changed page; the consumer indexes it (src/index/).
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "index-pages-dev" }],
    "consumers": [{ "queue": "index-pages-dev", "max_batch_size": 3, "max_batch_timeout": 10, "max_retries": 6, "max_concurrency": 3, "dead_letter_queue": "index-pages-dlq-dev" }]
  },
  // Daily: re-enqueue pages still waiting for a classification (src/index/reclassify.ts).
  "triggers": { "crons": ["17 4 * * *"] },

  "env": {
    "staging": {
      "name": "scoop-api-staging",
      "routes": [{ "pattern": "api-staging.scoop.md", "custom_domain": true }],
      "observability": {
        "enabled": true,
        // Invocation logs record the URL and request headers (install ID, client IP,
        // the admin Authorization header), so only our own one-line logs are kept.
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "EXTENSION_IDS": "",
        "CRAWL_BUCKET_NAME": "scoop-crawl-staging",
        "E2B_TEMPLATE_ID": "qj0i8b1c3ndy70ksd7ze",
        "ALLOW_ANY_EXTENSION": "1",
        "INDEX_DAILY_CAP_USD": "2",
        "INDEX_DAILY_TOTAL_CAP_USD": "10"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "scoop-staging", "database_id": "f3f020a8-fbce-46e5-b59f-5866c543fe46", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "SKILLS", "bucket_name": "scoop-skills-staging" },
        { "binding": "CRAWL", "bucket_name": "scoop-crawl-staging" }
      ],
      "workflows": [
        { "name": "crawl-site-staging", "binding": "CRAWL_SITE", "class_name": "CrawlSite" }
      ],
      "ratelimits": [
        { "name": "READ_LIMITER", "namespace_id": "4101", "simple": { "limit": 600, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "4111", "simple": { "limit": 60, "period": 60 } }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        { "binding": "VECTORS", "index_name": "scoop-chunks-staging" }
      ],
      "queues": {
        "producers": [{ "binding": "INDEX_QUEUE", "queue": "index-pages-staging" }],
        "consumers": [{ "queue": "index-pages-staging", "max_batch_size": 3, "max_batch_timeout": 10, "max_retries": 6, "max_concurrency": 3, "dead_letter_queue": "index-pages-dlq-staging" }]
      },
      "triggers": { "crons": ["17 4 * * *"] }
    },
    "production": {
      "name": "scoop-api",
      "routes": [{ "pattern": "api.scoop.md", "custom_domain": true }],
      "observability": {
        "enabled": true,
        // Invocation logs record the URL and request headers (install ID, client IP,
        // the admin Authorization header), so only our own one-line logs are kept.
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "vars": {
        "ENVIRONMENT": "production",
        "EXTENSION_IDS": "",
        "CRAWL_BUCKET_NAME": "scoop-crawl-production",
        "E2B_TEMPLATE_ID": "qj0i8b1c3ndy70ksd7ze",
        "INDEX_DAILY_CAP_USD": "2",
        "INDEX_DAILY_TOTAL_CAP_USD": "10"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "scoop-production", "database_id": "dfce240b-45c4-4ca1-a887-66be730d2b22", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "SKILLS", "bucket_name": "scoop-skills-production" },
        { "binding": "CRAWL", "bucket_name": "scoop-crawl-production" }
      ],
      "workflows": [
        { "name": "crawl-site", "binding": "CRAWL_SITE", "class_name": "CrawlSite" }
      ],
      "ratelimits": [
        { "name": "READ_LIMITER", "namespace_id": "4102", "simple": { "limit": 600, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "4112", "simple": { "limit": 60, "period": 60 } }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        { "binding": "VECTORS", "index_name": "scoop-chunks-production" }
      ],
      "queues": {
        "producers": [{ "binding": "INDEX_QUEUE", "queue": "index-pages-production" }],
        "consumers": [{ "queue": "index-pages-production", "max_batch_size": 3, "max_batch_timeout": 10, "max_retries": 6, "max_concurrency": 3, "dead_letter_queue": "index-pages-dlq-production" }]
      },
      "triggers": { "crons": ["17 4 * * *"] }
    }
  }
}
