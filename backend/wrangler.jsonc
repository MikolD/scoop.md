// api.scoop.md Worker. The top level is the local-dev config (`wrangler dev`);
// deploy only with `--env staging` or `--env production`.
// Bindings and vars are non-inheritable, so each environment repeats them.
// IDs marked REPLACE_ME are placeholders: see README.md, "Before the first deploy".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scoop-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    // Invocation logs record the URL and request headers (install ID, client IP,
    // the admin Authorization header), so only our own one-line logs are kept.
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },

  "vars": {
    "ENVIRONMENT": "dev",
    "EXTENSION_IDS": "",
    "CRAWL_BUCKET_NAME": "scoop-crawl-dev",
    "E2B_TEMPLATE_ID": "qj0i8b1c3ndy70ksd7ze",
    "INDEX_DAILY_CAP_USD": "2",
    "INDEX_DAILY_TOTAL_CAP_USD": "10",
    // Browser sandbox (E2B) spend per UTC day, USD.
    "E2B_DAILY_CAP_USD": "2",
    // Usage telemetry (docs/TELEMETRY.md): on | lifecycle | off; share of API requests
    // recorded (0-1); daily ceilings for events (then lifecycle only) and API rows.
    "TELEMETRY_INGEST": "on",
    "TELEMETRY_API_SAMPLE": "1",
    "TELEMETRY_DAILY_MAX": "2000000",
    "TELEMETRY_API_DAILY_MAX": "200000",
    // Crawl requests from the extension that may start a crawl, per UTC day, for everyone.
    "CRAWL_REQUESTS_DAILY_MAX": "300"
    // The admin console answers on admin.localhost only (ADMIN_HOST pins it in staging and production).
    // ALLOW_LOCALHOST, ALLOW_ANY_EXTENSION, ADMIN_TOKEN and RATE_KEY come from .dev.vars locally.
    // ALLOW_LOCALHOST is ignored unless ENVIRONMENT is "dev".
    // OPENROUTER_API_KEY (indexing) also comes from .dev.vars locally.
  },
  // The admin console's static UI (admin/), served only on admin hosts, after
  // Basic auth: the Worker runs first for every request (src/admin/app.ts).
  "assets": { "directory": "./admin", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "scoop-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" },
    // Usage telemetry, in its own database so a flood can never fill the library's (docs/TELEMETRY.md).
    { "binding": "TELEMETRY_DB", "database_name": "scoop-telemetry-dev", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations-telemetry" }
  ],
  "r2_buckets": [
    { "binding": "SKILLS", "bucket_name": "scoop-skills-dev" },
    { "binding": "CRAWL", "bucket_name": "scoop-crawl-dev" },
    // Raw telemetry archive: telemetry/raw/dt=…/hour=…/*.ndjson.gz and deletion tombstones (src/telemetry/archive.ts).
    { "binding": "TELEMETRY", "bucket_name": "scoop-telemetry-dev" }
  ],
  "workflows": [
    { "name": "crawl-site-dev", "binding": "CRAWL_SITE", "class_name": "CrawlSite" },
    // Seed crawl batches started from the admin console (src/admin/batch-workflow.ts).
    { "name": "crawl-batch-dev", "binding": "CRAWL_BATCH", "class_name": "CrawlBatch" }
  ],
  "ratelimits": [
    // Reads: 600 per minute per IP (docs/BACKEND.md §8). Hourly write limits live in D1.
    { "name": "READ_LIMITER", "namespace_id": "4100", "simple": { "limit": 600, "period": 60 } },
    // Search: 60 per minute per IP; each query costs a Workers AI embedding unless cached.
    { "name": "SEARCH_LIMITER", "namespace_id": "4110", "simple": { "limit": 60, "period": 60 } },
    // Admin console: failed Basic auth attempts, 10 per minute per IP, then a lockout (src/admin/auth.ts).
    { "name": "ADMIN_AUTH_LIMITER", "namespace_id": "4120", "simple": { "limit": 10, "period": 60 } },
    // POST /v1/events (src/telemetry/ingest.ts): 30 requests per minute per IP subject, 10 per install ID.
    { "name": "EVENTS_LIMITER", "namespace_id": "4130", "simple": { "limit": 30, "period": 60 } },
    { "name": "EVENTS_INSTALL_LIMITER", "namespace_id": "4133", "simple": { "limit": 10, "period": 60 } }
  ],
  // Workers AI and Vectorize have no local simulation, so `wrangler dev` uses the
  // real `scoop-chunks-dev` index (needs `wrangler login`). `wrangler dev --local`
  // (CI) turns remote bindings off: search then falls back to full-text only.
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [
    { "binding": "VECTORS", "index_name": "scoop-chunks-dev", "remote": true }
  ],
  // The crawler sends one message per changed page; the consumer indexes it (src/index/).
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "index-pages-dev" }, { "binding": "TELEMETRY_QUEUE", "queue": "telemetry-events-dev" }],
    "consumers": [{ "queue": "index-pages-dev", "max_batch_size": 3, "max_batch_timeout": 10, "max_retries": 6, "max_concurrency": 3, "dead_letter_queue": "index-pages-dlq-dev" },
      { "queue": "telemetry-events-dev", "max_batch_size": 50, "max_batch_timeout": 30, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "telemetry-events-dlq-dev" }]
  },
  // Daily (17 4): re-enqueue pages still waiting for a classification (src/index/reclassify.ts).
  // Hourly (23 *): prune telemetry (src/telemetry/consumer.ts); the cron string must match HOURLY in src/index.ts.
  "triggers": { "crons": ["17 4 * * *", "23 * * * *"] },

  "env": {
    "staging": {
      "name": "scoop-api-staging",
      "routes": [
        { "pattern": "api-staging.scoop.md", "custom_domain": true },
        { "pattern": "admin-staging.scoop.md", "custom_domain": true }
      ],
      "observability": {
        "enabled": true,
        // Invocation logs record the URL and request headers (install ID, client IP,
        // the admin Authorization header), so only our own one-line logs are kept.
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "EXTENSION_IDS": "",
        "CRAWL_BUCKET_NAME": "scoop-crawl-staging",
        "E2B_TEMPLATE_ID": "qj0i8b1c3ndy70ksd7ze",
        "ALLOW_ANY_EXTENSION": "1",
        "INDEX_DAILY_CAP_USD": "2",
        "INDEX_DAILY_TOTAL_CAP_USD": "10",
        "E2B_DAILY_CAP_USD": "2",
        "ADMIN_HOST": "admin-staging.scoop.md",
        "TELEMETRY_INGEST": "on",
        "TELEMETRY_API_SAMPLE": "1",
        "TELEMETRY_DAILY_MAX": "2000000",
        "TELEMETRY_API_DAILY_MAX": "200000",
        // Crawl requests from the extension that may start a crawl, per UTC day, for everyone.
        "CRAWL_REQUESTS_DAILY_MAX": "300"
      },
      "assets": { "directory": "./admin", "binding": "ASSETS", "run_worker_first": true },
      "d1_databases": [
        { "binding": "DB", "database_name": "scoop-staging", "database_id": "f3f020a8-fbce-46e5-b59f-5866c543fe46", "migrations_dir": "migrations" },
        { "binding": "TELEMETRY_DB", "database_name": "scoop-telemetry-staging", "database_id": "d059ae06-4a40-40ac-b096-5d511b2b0b89", "migrations_dir": "migrations-telemetry" }
      ],
      "r2_buckets": [
        { "binding": "SKILLS", "bucket_name": "scoop-skills-staging" },
        { "binding": "CRAWL", "bucket_name": "scoop-crawl-staging" },
        // Raw telemetry archive: telemetry/raw/dt=…/hour=…/*.ndjson.gz and deletion tombstones (src/telemetry/archive.ts).
        { "binding": "TELEMETRY", "bucket_name": "scoop-telemetry-staging" }
      ],
      "workflows": [
        { "name": "crawl-site-staging", "binding": "CRAWL_SITE", "class_name": "CrawlSite" },
        { "name": "crawl-batch-staging", "binding": "CRAWL_BATCH", "class_name": "CrawlBatch" }
      ],
      "ratelimits": [
        { "name": "READ_LIMITER", "namespace_id": "4101", "simple": { "limit": 600, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "4111", "simple": { "limit": 60, "period": 60 } },
        { "name": "ADMIN_AUTH_LIMITER", "namespace_id": "4121", "simple": { "limit": 10, "period": 60 } },
        { "name": "EVENTS_LIMITER", "namespace_id": "4131", "simple": { "limit": 30, "period": 60 } },
        { "name": "EVENTS_INSTALL_LIMITER", "namespace_id": "4134", "simple": { "limit": 10, "period": 60 } }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        { "binding": "VECTORS", "index_name": "scoop-chunks-staging" }
      ],
      "queues": {
        "producers": [{ "binding": "INDEX_QUEUE", "queue": "index-pages-staging" }, { "binding": "TELEMETRY_QUEUE", "queue": "telemetry-events-staging" }],
        "consumers": [{ "queue": "index-pages-staging", "max_batch_size": 3, "max_batch_timeout": 10, "max_retries": 6, "max_concurrency": 3, "dead_letter_queue": "index-pages-dlq-staging" },
          { "queue": "telemetry-events-staging", "max_batch_size": 50, "max_batch_timeout": 30, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "telemetry-events-dlq-staging" }]
      },
      "triggers": { "crons": ["17 4 * * *", "23 * * * *"] }
    },
    "production": {
      "name": "scoop-api",
      "routes": [
        { "pattern": "api.scoop.md", "custom_domain": true },
        { "pattern": "admin.scoop.md", "custom_domain": true }
      ],
      "observability": {
        "enabled": true,
        // Invocation logs record the URL and request headers (install ID, client IP,
        // the admin Authorization header), so only our own one-line logs are kept.
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "vars": {
        "ENVIRONMENT": "production",
        // The Chrome Web Store build of the extension.
        "EXTENSION_IDS": "ccfbndgiomnmpanklpmadpapkocihfpd",
        "CRAWL_BUCKET_NAME": "scoop-crawl-production",
        "E2B_TEMPLATE_ID": "qj0i8b1c3ndy70ksd7ze",
        "INDEX_DAILY_CAP_USD": "2",
        "INDEX_DAILY_TOTAL_CAP_USD": "10",
        "E2B_DAILY_CAP_USD": "2",
        "ADMIN_HOST": "admin.scoop.md",
        "TELEMETRY_INGEST": "on",
        "TELEMETRY_API_SAMPLE": "1",
        "TELEMETRY_DAILY_MAX": "2000000",
        "TELEMETRY_API_DAILY_MAX": "200000",
        // Crawl requests from the extension that may start a crawl, per UTC day, for everyone.
        "CRAWL_REQUESTS_DAILY_MAX": "300"
      },
      "assets": { "directory": "./admin", "binding": "ASSETS", "run_worker_first": true },
      "d1_databases": [
        { "binding": "DB", "database_name": "scoop-production", "database_id": "dfce240b-45c4-4ca1-a887-66be730d2b22", "migrations_dir": "migrations" },
        { "binding": "TELEMETRY_DB", "database_name": "scoop-telemetry-production", "database_id": "1ea9ed26-92e3-4d1e-a031-bba44dbd11e0", "migrations_dir": "migrations-telemetry" }
      ],
      "r2_buckets": [
        { "binding": "SKILLS", "bucket_name": "scoop-skills-production" },
        { "binding": "CRAWL", "bucket_name": "scoop-crawl-production" },
        // Raw telemetry archive: telemetry/raw/dt=…/hour=…/*.ndjson.gz and deletion tombstones (src/telemetry/archive.ts).
        { "binding": "TELEMETRY", "bucket_name": "scoop-telemetry-production" }
      ],
      "workflows": [
        { "name": "crawl-site", "binding": "CRAWL_SITE", "class_name": "CrawlSite" },
        { "name": "crawl-batch", "binding": "CRAWL_BATCH", "class_name": "CrawlBatch" }
      ],
      "ratelimits": [
        { "name": "READ_LIMITER", "namespace_id": "4102", "simple": { "limit": 600, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "4112", "simple": { "limit": 60, "period": 60 } },
        { "name": "ADMIN_AUTH_LIMITER", "namespace_id": "4122", "simple": { "limit": 10, "period": 60 } },
        { "name": "EVENTS_LIMITER", "namespace_id": "4132", "simple": { "limit": 30, "period": 60 } },
        { "name": "EVENTS_INSTALL_LIMITER", "namespace_id": "4135", "simple": { "limit": 10, "period": 60 } }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        { "binding": "VECTORS", "index_name": "scoop-chunks-production" }
      ],
      "queues": {
        "producers": [{ "binding": "INDEX_QUEUE", "queue": "index-pages-production" }, { "binding": "TELEMETRY_QUEUE", "queue": "telemetry-events-production" }],
        "consumers": [{ "queue": "index-pages-production", "max_batch_size": 3, "max_batch_timeout": 10, "max_retries": 6, "max_concurrency": 3, "dead_letter_queue": "index-pages-dlq-production" },
          { "queue": "telemetry-events-production", "max_batch_size": 50, "max_batch_timeout": 30, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "telemetry-events-dlq-production" }]
      },
      "triggers": { "crons": ["17 4 * * *", "23 * * * *"] }
    }
  }
}
