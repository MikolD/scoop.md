# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
ADMIN_TOKEN=local-admin-token
# HMAC key for rate-limit counters.
RATE_KEY=local-rate-key
# Local dev only: lets the Worker verify sources on http://localhost (the contract tests' fixture server).
ALLOW_LOCALHOST=1
ALLOW_ANY_EXTENSION=1
# Browser crawls (E2B). Leave unset to skip them; never commit a real key.
# E2B_API_KEY=
# R2 S3 API token for presigned result uploads. Optional in local dev: without
# it the Workflow reads the result from the sandbox instead.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
