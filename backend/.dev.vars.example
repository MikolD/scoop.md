# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
ADMIN_TOKEN=local-admin-token
# HMAC key for rate-limit counters.
RATE_KEY=local-rate-key
# Local dev only: lets the Worker verify sources on http://localhost (the contract tests' fixture server).
ALLOW_LOCALHOST=1
ALLOW_ANY_EXTENSION=1
# Browser crawls (E2B). Leave unset to skip them; never commit a real key.
# E2B_API_KEY=
# Optional R2 S3 API token: the sandbox then uploads its result to a presigned
# URL. Without it (the default) the Workflow reads the result from the sandbox.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# Indexing (POST /v1/admin/index, the index-pages consumer). Never commit a real key.
# OPENROUTER_API_KEY=<your OpenRouter key>
# Admin console (admin.localhost:8787 locally): Basic auth user and passcode. Unset = no one gets in.
ADMIN_UI_USER=admin
ADMIN_UI_PASSCODE=local-admin-passcode
# Usage telemetry: salts the daily-rotating IP-subject hash and the website's visitor ID. Any random string locally.
TELEMETRY_SALT=local-telemetry-salt
